# Copy to .env and fill in. These values are PUBLIC (they end up in the browser bundle).
# Never put passwords, private API keys or SMTP credentials here.

# Form service endpoint for enquiries (e.g. Formspree: https://formspree.io/f/xxxxxxxx)
VITE_FORM_ENDPOINT=
# Optional separate endpoint for review submissions (falls back to VITE_FORM_ENDPOINT)
VITE_REVIEW_ENDPOINT=
# Production domain, no trailing slash (enables canonical URLs), e.g. https://www.example.com
VITE_SITE_URL=
# WhatsApp number in international format, digits only, e.g. 919XXXXXXXXX. Leave empty to hide the button.
VITE_WHATSAPP_NUMBER=
# Optional analytics (only loaded after the visitor accepts the consent banner)
VITE_GTM_ID=
